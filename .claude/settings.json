{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/home/david/.claude/hooks/graphify-first-bash.sh" }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          { "type": "command", "command": "/home/david/.claude/hooks/graphify-first-read.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "/home/david/.claude/hooks/resume-from-handoff.sh" }
        ]
      }
    ]
  }
}
